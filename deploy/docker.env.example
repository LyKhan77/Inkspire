# Copy to .env.docker on the target server. Keep that file private and out of Git.
# Required: https://<private-ipv4>:<explicit-port>, port >= 1024.
INKSPIRE_PUBLIC_ORIGIN=
# Companion HTTP port on host loopback, distinct from the HTTPS port.
INKSPIRE_PORT=4173
INKSPIRE_IMAGE=inkspire:docker-local
# Backend only. Set the endpoint reachable from the server host.
MAPIC_BASE_URL=
MAPIC_SERVICE_TOKEN=
